# No required environment variables for development.
# Service URLs (MEILI_URL, RSS_BRIDGE_URL, etc.) are set in compose.yaml.
#
# Optional overrides:
# JWT_SECRET=<string>           (default: auto-generated and stored in DB)
# LOG_LEVEL=debug               (default: info)
# TZ=Asia/Tokyo                 (default: UTC)
# AUTH_DISABLED=1               (requires NODE_ENV=development; server will refuse to start otherwise)
# SCORE_RECALC_SCHEDULE=0 3 * * *  (default: */5 * * * *; set to daily if event-driven covers all actions)
# FLARESOLVERR_URL=http://192.168.1.10:8191  (FlareSolverr or the API-compatible Byparr; unset disables the browser fallback)
# FLARESOLVERR_CONCURRENCY=2    (default: 0 = unlimited; browser-based solvers are heavy, bound them)
# FLARESOLVERR_TIMEOUT_MS=60000 (per-page budget; raise it when the solver stalls on a site, e.g. 150000)
# VLLM_BASE_URL=http://host.docker.internal:8000
# REDDIT_CLIENT_ID=<id>         (script app from reddit.com/prefs/apps; used for comments + crosspost content when anonymous .json endpoints are blocked)
# REDDIT_CLIENT_SECRET=<secret>
# REDDIT_COOKIE=reddit_session=<value>  (logged-in browser cookie; passes IP reputation blocks that reject anonymous requests)
# BLUESKY_IDENTIFIER=<handle>   (required for Bluesky search feeds; searchPosts rejects unauthenticated requests)
# BLUESKY_APP_PASSWORD=<app password from bsky.app Settings -> App Passwords>
# BLUESKY_PDS_URL=https://bsky.social  (only for a self-hosted PDS)
#
# Production (compose.prod.yaml):
# MEILI_MASTER_KEY=<string>     (required for production Meilisearch)
# TUNNEL_TOKEN=<token>          (required for Cloudflare Tunnel)
# DATA_DIR=$HOME/.oksskolten/data   (default: ./data; set absolute path for prod)
# TURSO_AUTH_TOKEN=<token>      (only if using Turso instead of local SQLite)
